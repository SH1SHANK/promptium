{
  "manifest_version": 3,
  "name": "Promptium",
  "short_name": "Promptium",
  "description": "Advanced prompt management and AI workflow extension with semantic search, templates, optimization, and chat export.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/promptium/icon16.png",
    "32": "icons/promptium/icon32.png",
    "48": "icons/promptium/icon48.png",
    "128": "icons/promptium/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/promptium/icon16.png",
      "32": "icons/promptium/icon32.png"
    },
    "default_title": "Promptium"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads",
    "sidePanel",
    "contextMenus",
    "offscreen"
  ],
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "Open Promptium side panel"
    }
  },
  "host_permissions": [
    "*://*.chatgpt.com/*",
    "*://*.claude.ai/*",
    "*://gemini.google.com/*",
    "*://*.perplexity.ai/*",
    "*://copilot.microsoft.com/*",
    "*://*.deepseek.com/*",
    "*://*.qwen.ai/*",
    "*://*.qwenlm.ai/*",
    "*://tongyi.aliyun.com/*",
    "*://qianwen.aliyun.com/*",
    "*://chat.mistral.ai/*",
    "*://lechat.mistral.ai/*",
    "*://kimi.moonshot.cn/*",
    "*://*.moonshot.cn/*",
    "*://*.moonshot.ai/*",
    "*://grok.com/*",
    "*://*.grok.com/*",
    "*://x.com/*",
    "*://twitter.com/*",
    "*://huggingchat.com/*",
    "*://*.huggingchat.com/*",
    "*://huggingface.co/chat*",
    "*://*.poe.com/*",
    "*://*.you.com/*",
    "*://*.phind.com/*",
    "*://*.character.ai/*",
    "*://*.pi.ai/*",
    "*://*.meta.ai/*",
    "*://chat.console.aws.amazon.com/*",
    "*://yiyan.baidu.com/*",
    "*://ernie.baidu.com/*",
    "*://*.doubao.com/*",
    "*://*.01.ai/*",
    "*://*.cohere.com/*",
    "*://chat.groq.com/*",
    "*://*.fireworks.ai/*",
    "*://*.together.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://openrouter.ai/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self'; font-src 'self' data:"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chatgpt.com/*",
        "*://*.claude.ai/*",
        "*://gemini.google.com/*",
        "*://*.perplexity.ai/*",
        "*://copilot.microsoft.com/*",
        "*://*.deepseek.com/*",
        "*://*.qwen.ai/*",
        "*://*.qwenlm.ai/*",
        "*://tongyi.aliyun.com/*",
        "*://qianwen.aliyun.com/*",
        "*://chat.mistral.ai/*",
        "*://lechat.mistral.ai/*",
        "*://kimi.moonshot.cn/*",
        "*://*.moonshot.cn/*",
        "*://*.moonshot.ai/*",
        "*://grok.com/*",
        "*://*.grok.com/*",
        "*://x.com/*",
        "*://twitter.com/*",
        "*://huggingchat.com/*",
        "*://*.huggingchat.com/*",
        "*://huggingface.co/chat*",
        "*://*.poe.com/*",
        "*://*.you.com/*",
        "*://*.phind.com/*",
        "*://*.character.ai/*",
        "*://*.pi.ai/*",
        "*://*.meta.ai/*",
        "*://chat.console.aws.amazon.com/*",
        "*://yiyan.baidu.com/*",
        "*://ernie.baidu.com/*",
        "*://*.doubao.com/*",
        "*://*.01.ai/*",
        "*://*.cohere.com/*",
        "*://chat.groq.com/*",
        "*://*.fireworks.ai/*",
        "*://*.together.ai/*"
      ],
      "js": [
        "libs/jspdf.min.js",
        "utils/constants.js",
        "utils/dom-helpers.js",
        "utils/tags.js",
        "utils/platform.js",
        "utils/storage.js",
        "utils/template-parser.js",
        "utils/smart-name.js",
        "utils/exporter.js",
        "utils/bridge.js",
        "utils/continuation.js",
        "utils/templates.js",
        "content/scraper.js",
        "content/injector.js",
        "content/toolbar.js",
        "content/bookmarks.js",
        "content/content.js"
      ],
      "css": [
        "content/fab.css",
        "content/toolbar.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "libs/jspdf.min.js",
        "libs/transformers.min.js",
        "models/*",
        "offscreen/local-model-worker.html",
        "offscreen/local-model-worker.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*"
      ]
    }
  ]
}
