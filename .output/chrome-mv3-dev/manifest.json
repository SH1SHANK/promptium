{
  "manifest_version": 3,
  "name": "Promptium",
  "description": "Advanced prompt management extension with semantic search, templates, optimization, and chat export.",
  "version": "0.1.0",
  "short_name": "Promptium",
  "icons": {
    "16": "icons/promptium/icon16.png",
    "32": "icons/promptium/icon32.png",
    "48": "icons/promptium/icon48.png",
    "128": "icons/promptium/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/promptium/icon16.png",
      "32": "icons/promptium/icon32.png"
    },
    "default_title": "Promptium"
  },
  "permissions": [
    "storage",
    "activeTab",
    "windows",
    "scripting",
    "downloads",
    "sidePanel",
    "contextMenus",
    "tabs"
  ],
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "Open Promptium side panel"
    },
    "wxt:reload-extension": {
      "description": "Reload the extension during development",
      "suggested_key": {
        "default": "Alt+R"
      }
    }
  },
  "host_permissions": [
    "*://*.chatgpt.com/*",
    "*://*.claude.ai/*",
    "*://gemini.google.com/*",
    "*://*.perplexity.ai/*",
    "*://copilot.microsoft.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://localhost/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' http://localhost:3000; object-src 'self'; style-src 'self'; font-src 'self' data:;",
    "sandbox": "script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:3000; sandbox allow-scripts allow-forms allow-popups allow-modals; child-src 'self';"
  },
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "109.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["libs/jspdf.min.js"],
      "matches": [
        "*://*.chatgpt.com/*",
        "*://*.claude.ai/*",
        "*://gemini.google.com/*",
        "*://*.perplexity.ai/*",
        "*://copilot.microsoft.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
