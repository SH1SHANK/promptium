{
  "name": "promptium",
  "description": "Promptium Chrome extension for prompt libraries, semantic search, AI prompt improvement, and chat exports.",
  "version": "1.0.0",
  "packageManager": "pnpm@8.9.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test:adapters": "npx tsx src/platforms/testing/run.ts",
    "test:context-menu": "npx tsx src/features/context-menu/context-menu.test.ts",
    "test:importer": "npx tsx src/features/vault/importer/importer.test.ts",
    "test:cre": "npx tsx src/features/refinement/intelligence/cre/cre.test.ts",
    "lint": "eslint 'src/**/*.ts'",
    "prettier:check": "prettier --check 'src/**/*.{ts,css,html}'",
    "format": "prettier --write .",
    "knip": "knip",
    "verify": "pnpm typecheck && pnpm lint && pnpm knip --exclude exports,types,nsExports,nsTypes,classMembers,enumMembers,duplicates,unlisted,binaries && pnpm test:adapters && pnpm test:context-menu && pnpm test:importer && pnpm test:cre && pnpm build",
    "postinstall": "wxt prepare"
  },
  "private": true,
  "devDependencies": {
    "@types/chrome": "^0.1.43",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "knip": "^5.45.0",
    "postcss": "^8.5.15",
    "prettier": "^3.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.23.0",
    "wxt": "^0.20.26"
  },
  "dependencies": {
    "compromise": "^14.15.1",
    "fuse.js": "^7.4.2",
    "harper.js": "^2.4.0",
    "js-tiktoken": "^1.0.21"
  }
}
